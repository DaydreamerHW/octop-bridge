# Octop Server Connection Configuration
OCTOP_URL=http://192.168.5.192:8089

# Authentication (either Username/Password or Direct Token)
OCTOP_USERNAME=xqx
OCTOP_PASSWORD=your_secure_password
# OCTOP_TOKEN=your_jwt_access_token_here

# Default Target Agent (by ID like PQG34P or display name like "小通")
OCTOP_AGENT_ID=PQG34P

# Connection & TLS
OCTOP_TIMEOUT=180
# OCTOP_INSECURE=true  # Set to true for self-signed certificates on home NAS
